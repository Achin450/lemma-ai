# =============================================================================
# Lemma AI - Environment Configuration Example
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit your actual .env file or real secrets to version control.
# =============================================================================

# Project & Environment Settings
ENVIRONMENT=development
PROJECT_NAME="Lemma AI Research & Academic Integrity Platform"
FRONTEND_URL=https://lemma2.vercel.app
BACKEND_PUBLIC_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lemma
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/lemma

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Cloud LLM Settings (Groq / OpenAI / Custom Provider)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# OpenAI or OpenAI-Compatible API (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama Settings (Optional fallback for offline inference)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=lemma-model

# -----------------------------------------------------------------------------
# Search & Cache (Elasticsearch & Redis)
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=true

# -----------------------------------------------------------------------------
# Academic Retrieval APIs
# -----------------------------------------------------------------------------
ENABLE_ONLINE_RETRIEVAL=true
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
MAX_ONLINE_CANDIDATES_PER_QUERY=30

# -----------------------------------------------------------------------------
# OAuth 2.0 Social Logins (Google & GitHub)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# -----------------------------------------------------------------------------
# Payment Gateways (Razorpay & Stripe)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# -----------------------------------------------------------------------------
# Email / SMTP Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_EMAIL=noreply@lemma.ai
