# Caddyfile - Automatic HTTPS reverse proxy for Lemma AI Backend
# Replace 'api.yourdomain.com' with your actual domain pointing to the server IP.

{$BACKEND_DOMAIN:api.yourdomain.com} {
    # Reverse proxy all requests to the FastAPI backend container
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Enable gzip & zstd compression
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
