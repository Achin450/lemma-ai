# =============================================================================
# Lemma AI - Production Environment Configuration Template
# =============================================================================

# Project & Environment
ENVIRONMENT=production
PROJECT_NAME="Lemma AI Academic Research Platform"
FRONTEND_URL=https://lemma2.vercel.app
BACKEND_PUBLIC_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Cloud LLM Settings (Fast & Cost-Effective: No GPU Needed!)
# -----------------------------------------------------------------------------
# Option A: Groq Cloud (Recommended - Ultra-fast Llama-3.3-70B, High Free Tier / Cheap)
GROQ_API_KEY=gsk_your_groq_api_key_here
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI API / DeepSeek / Any OpenAI-compatible Provider
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Database Settings (Docker Postgres container)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_production_password_here
POSTGRES_DB=lemma
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/lemma

# -----------------------------------------------------------------------------
# Redis & Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_ALWAYS_EAGER=false

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_64_character_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# OAuth Authentication (Google & GitHub)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# -----------------------------------------------------------------------------
# Academic Retrieval APIs
# -----------------------------------------------------------------------------
ENABLE_ONLINE_RETRIEVAL=true
SEMANTIC_SCHOLAR_API_KEY=
